# WeaveNet 织网穿透 环境变量模板
# 复制为 .env 并填写实际值
# 文档：CQFISH&喵酱出品

# 面板
# 容器内监听 8000，compose 已强制，宿主映射 8100（勿改 PANEL_PORT）
PANEL_PORT=8000
PANEL_HOST=0.0.0.0
# 面板对外基础地址（用于邮件链接），填公网可访问地址
PANEL_BASE_URL=http://你的域名或IP:8100

# 数据库（容器内路径）
DATABASE_URL=sqlite:////app/data/weavenet.db

# 安全密钥（生产必改，可用：openssl rand -hex 32 生成）
SECRET_KEY=please-change-me-to-a-long-random-secret

# 管理员初始账号（仅首次启动生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@weave.test

# SMTP（留空则开发模式，邮件打印到日志）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_USE_TLS=true

# 域名后缀：用户申请二级域名的基础后缀，需配置 *.该域名 泛解析到本服务器
DOMAIN_SUFFIX=cqfishnet.cn

# 应急服务密钥：Go 版应急服务读取 emergency/emergency.conf 的 secret_key，
# 此环境变量不生效，请直接编辑 emergency.conf（生产必改，>=32 位）
