# WeaveNet 织网穿透 环境变量模板
# 复制为 .env 并填写实际值

# 面板
PANEL_PORT=8100
PANEL_HOST=0.0.0.0
# 面板对外基础地址（用于邮件链接与客户端配置）
PANEL_BASE_URL=http://localhost:8100

# 数据库（容器内路径）
DATABASE_URL=sqlite:////app/data/weavenet.db

# Redis
REDIS_URL=redis://weave-redis:6379/0

# 安全密钥（生产必改，生成命令：python -c "import secrets;print(secrets.token_hex(32))"）
SECRET_KEY=please-change-me-to-a-long-random-secret

# 管理员初始账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@weave.test

# SMTP（留空则开发模式，邮件打印到日志）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_USE_TLS=true

# 免费域名占位（上线前替换为正式域名并配置泛解析）
DOMAIN_SUFFIX=weave.test

# 应急服务密钥（>=32 位，生产必改）
EMERGENCY_SECRET_KEY=please-change-me-urgent
